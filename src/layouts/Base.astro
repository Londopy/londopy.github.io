---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "../styles/global.css";
import CursorOrb from "../components/CursorOrb.astro";
import TopoBackground from "../components/TopoBackground.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: unknown;
}

const { title, description, ogImage: ogImagePath, jsonLd } = Astro.props;
const ogImage = new URL(ogImagePath ?? "/og-image.png", Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- apply the saved accent theme before first paint (no flash) -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem("theme");
          const ok = ["amber", "slate", "terracotta"];
          document.documentElement.dataset.theme = ok.includes(t) ? t : "amber";
        } catch (e) {
          document.documentElement.dataset.theme = "amber";
        }
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#0a0e13" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <slot name="head" />
  </head>
  <body>
    <TopoBackground />
    <slot />
    <CursorOrb />
  </body>
</html>
