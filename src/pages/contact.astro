---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const title = "Contact — London C.";
const description =
  "Get in touch with London C. — send a message and it lands in my inbox. No account, no login. Optional PGP end-to-end encryption.";

// Public Web3Forms access key. Designed to live in client HTML — it only
// allows submitting this form and never exposes the destination address.
const ACCESS_KEY = "3ebb2c5a-06db-4542-a8da-9c65f0d8e18f";

// --- optional features, activated by filling in a single public value ---

// "Open to work" note in the hero. Flip to false to hide it.
const OPEN_TO_WORK = true;
const OPEN_TO_WORK_TEXT = "open to internships — security & systems";

// Spam captcha. Paste an hCaptcha *site key* (public) to turn it on, and
// enable hCaptcha in the Web3Forms dashboard so submissions are validated.
// Empty = honeypot-only (no captcha shown).
const HCAPTCHA_SITEKEY = "";

// End-to-end PGP encryption. Paste your ASCII-armored *public* key to offer
// senders an "encrypt" toggle; the message is encrypted in their browser so
// only your private key can read it — Web3Forms only ever relays ciphertext.
// Empty = the encryption option is hidden.
const PGP_PUBLIC_KEY = `-----BEGIN PGP PUBLIC KEY BLOCK-----

mDMEaq+KNhYJKwYBBAHaRw8BAQdAgecubJTOMQrZl8Jmq7NpA9oCDW3IL1TF71bU
X8vtic20H0xvbmRvIDxsb25kb24ud29ya0BweGRtYWlsLmNvbT6IlgQTFgoAPhYh
BPAQU7hv59YKCh+3kLEeAvES+vSXBQJqr4o2AhsDBQkDwmcABQsJCAcCBhUKCQgL
AgQWAgMBAh4BAheAAAoJELEeAvES+vSXaDoBAKM6kDhMUuqSp6QzmOVtmgFkhNsA
W8g943cziwmKIBNEAP9i0SAFkQ1G2nPjkyviBdgy6HmJ8LzaTglVI7UfXaWXBLg4
BGqvijYSCisGAQQBl1UBBQEBB0AWw9pWQHQWSUq2Tyui+nHvC81brHkKXiERnp9T
1BtiPwMBCAeIeAQYFgoAIBYhBPAQU7hv59YKCh+3kLEeAvES+vSXBQJqr4o2AhsM
AAoJELEeAvES+vSXLN0BANC7h72/FHLHzcKUJUxl5kuGADAJpuW5b31tF1PtMjq3
AP0XnX7kHqSy+00jF0Qu1FQPglyQaO8S8b98z1IsYxDwAg==
=gw7L
-----END PGP PUBLIC KEY BLOCK-----`;
const PGP_FINGERPRINT = "F010 53B8 6FE7 D60A 0A1F B790 B11E 02F1 12FA F497";

// Self-hosted-integrity crypto: pinned version + SRI hash.
const OPENPGP_SRC = "https://cdn.jsdelivr.net/npm/openpgp@5.11.3/dist/openpgp.min.js";
const OPENPGP_SRI = "sha384-meIGn/s43odkPR2f+TEg/YjO3USCOe6sc/il0iIBsWuV9K8kfAH/7Nepy2ErHxV6";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact — London C.",
  url: "https://londopy.github.io/contact/",
  mainEntity: {
    "@type": "Person",
    name: "London C.",
    alternateName: "Londopy",
    url: "https://londopy.github.io",
    sameAs: ["https://github.com/Londopy"],
  },
};
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <Nav active="contact" />

  <main class="container contact">
    <header class="c-hero rise">
      <p class="prompt mono" aria-hidden="true">
        <span class="user">londopy</span><span class="at">@</span><span class="host">github</span><span class="path">:~$</span>
        mail -s "hello" london
      </p>
      <h1>Get in touch</h1>
      {OPEN_TO_WORK && (
        <p class="open-badge mono"><span class="pulse" aria-hidden="true"></span> {OPEN_TO_WORK_TEXT}</p>
      )}
      <p class="lede">
        Recruiter, collaborator, or just want to talk shop — write a line and it
        lands straight in my inbox. No account, no login, and your note goes only
        to me.
      </p>
    </header>

    <form
      id="contact-form"
      class="c-form rise"
      style="animation-delay: 0.05s"
      action="https://api.web3forms.com/submit"
      method="POST"
    >
      <input type="hidden" name="access_key" value={ACCESS_KEY} />
      <input type="hidden" name="subject" value="New message from londopy.github.io" />
      <input type="hidden" name="from_name" value="londopy.github.io" />
      <!-- honeypot: real people leave this empty; bots fill it and get dropped -->
      <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="field">
        <label class="mono" for="name">name</label>
        <input id="name" name="name" type="text" required autocomplete="name" placeholder="Jane Doe" />
      </div>

      <div class="field">
        <label class="mono" for="email">email</label>
        <input id="email" name="email" type="email" required autocomplete="email" placeholder="jane@company.com" />
        <span class="hint mono">so I can reply — never shown publicly</span>
      </div>

      <div class="field">
        <label class="mono" for="message">message</label>
        <textarea id="message" name="message" rows="6" required placeholder="What's on your mind?"></textarea>
      </div>

      {PGP_PUBLIC_KEY && (
        <div class="pgp">
          <label class="pgp-toggle mono">
            <input type="checkbox" id="pgp-encrypt" />
            <span aria-hidden="true">🔒</span> encrypt my message (PGP, end-to-end)
          </label>
          <p class="hint mono">
            Your message is encrypted in your browser with my public key — only I
            can read it. Name &amp; email stay readable so I can reply; put anything
            sensitive in the message itself.
          </p>
          <details class="pgp-key">
            <summary class="mono">view my public key{PGP_FINGERPRINT ? ` · ${PGP_FINGERPRINT}` : ""}</summary>
            <pre class="mono">{PGP_PUBLIC_KEY}</pre>
          </details>
        </div>
      )}

      {HCAPTCHA_SITEKEY && (
        <div class="h-captcha" data-sitekey={HCAPTCHA_SITEKEY} data-theme="dark"></div>
      )}

      <div class="actions">
        <button class="submit mono" type="submit">
          <span class="dollar" aria-hidden="true">$</span> send message
        </button>
        <p id="form-status" class="status mono" role="status" aria-live="polite"></p>
      </div>
    </form>

    <p class="alt mono">
      prefer another channel? &nbsp;<span class="discord">discord <strong>_londo</strong></span>
      &nbsp;·&nbsp; <span class="irc">irc <strong>Londopy</strong> @ irc.libera.chat</span>
      &nbsp;·&nbsp; <a href="https://github.com/Londopy">github.com/Londopy</a>
    </p>
    <p class="alt-hint mono">
      on irc: <code>/msg Londopy</code> from any client, or straight from
      <a href="https://web.libera.chat">web.libera.chat</a> — no account needed.
      I stay connected, so it reaches me even when I'm away from the keyboard.
    </p>
  </main>

  {HCAPTCHA_SITEKEY && <script src="https://js.hcaptcha.com/1/api.js" async defer></script>}

  <Footer />
</Base>

<script define:vars={{ OPENPGP_SRC, OPENPGP_SRI, PGP_PUBLIC_KEY }}>
  const form = document.getElementById("contact-form");
  const status = document.getElementById("form-status");
  const pgpToggle = document.getElementById("pgp-encrypt");

  // lazy-load the crypto library only when someone chooses to encrypt
  let openpgpPromise = null;
  function loadOpenPGP() {
    if (window.openpgp) return Promise.resolve(window.openpgp);
    if (openpgpPromise) return openpgpPromise;
    openpgpPromise = new Promise((res, rej) => {
      const s = document.createElement("script");
      s.src = OPENPGP_SRC;
      s.integrity = OPENPGP_SRI;
      s.crossOrigin = "anonymous";
      s.onload = () => (window.openpgp ? res(window.openpgp) : rej(new Error("openpgp unavailable")));
      s.onerror = () => rej(new Error("failed to load openpgp"));
      document.head.appendChild(s);
    });
    return openpgpPromise;
  }
  // warm it up as soon as the sender opts in, so submit is instant
  if (pgpToggle) pgpToggle.addEventListener("change", () => { if (pgpToggle.checked) loadOpenPGP().catch(() => {}); });

  if (form && status) {
    const btn = form.querySelector("button[type=submit]");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      if (data.botcheck) { // honeypot tripped — drop it, pretend success
        status.textContent = "message sent — thanks!";
        status.className = "status mono ok";
        form.reset();
        return;
      }

      // optional end-to-end encryption. if it fails, send NOTHING.
      if (pgpToggle && pgpToggle.checked && PGP_PUBLIC_KEY) {
        status.textContent = "encrypting…";
        status.className = "status mono";
        try {
          const openpgp = await loadOpenPGP();
          const key = await openpgp.readKey({ armoredKey: PGP_PUBLIC_KEY });
          const message = await openpgp.createMessage({ text: String(data.message || "") });
          data.message = await openpgp.encrypt({ message, encryptionKeys: key });
          data.subject = "[PGP encrypted] New message from londopy.github.io";
        } catch (err) {
          status.textContent = "couldn't encrypt — nothing was sent. try again, or uncheck encryption.";
          status.className = "status mono err";
          return;
        }
      }

      status.textContent = "sending…";
      status.className = "status mono";
      if (btn) btn.disabled = true;
      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (json.success) {
          status.textContent = "message sent — I'll get back to you. thanks!";
          status.className = "status mono ok";
          form.reset();
          if (window.hcaptcha) try { window.hcaptcha.reset(); } catch (_) {}
        } else {
          status.textContent = "something went wrong — reach me on GitHub instead.";
          status.className = "status mono err";
        }
      } catch {
        status.textContent = "network error — please try again, or reach me on GitHub.";
        status.className = "status mono err";
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
</script>

<style>
  .contact {
    padding-top: 3.5rem;
    max-width: 680px;
  }

  .c-hero {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.75rem;
  }

  .prompt {
    color: var(--text-dim);
    font-size: 0.85rem;
    margin-bottom: 1.25rem;
  }

  .prompt .user { color: var(--accent); }
  .prompt .at { color: var(--text-faint); }
  .prompt .host { color: var(--text); }
  .prompt .path { color: var(--text-faint); margin-right: 0.6em; }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
  }

  .open-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.78rem;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid rgba(var(--accent-rgb), 0.35);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
    margin-bottom: 0.9rem;
  }

  .open-badge .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0.5);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0.5); }
    70% { box-shadow: 0 0 0 7px rgba(var(--accent-rgb), 0); }
    100% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .open-badge .pulse { animation: none; }
  }

  .lede {
    color: var(--text-dim);
    font-size: 1.02rem;
    line-height: 1.6;
    max-width: 60ch;
  }

  .c-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem 1.5rem 1.6rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-size: 0.78rem;
    color: var(--text-dim);
  }

  .field label::before {
    content: "> ";
    color: var(--accent);
  }

  input[type="text"],
  input[type="email"],
  textarea {
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    background: var(--bg-raised);
    border: 1px solid var(--border-bright);
    border-radius: 5px;
    padding: 0.6rem 0.75rem;
    width: 100%;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  textarea {
    resize: vertical;
    min-height: 7rem;
    line-height: 1.55;
  }

  input::placeholder,
  textarea::placeholder {
    color: var(--text-faint);
  }

  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }

  .hint {
    font-size: 0.72rem;
    color: var(--text-faint);
    line-height: 1.5;
  }

  /* honeypot — hidden from humans, present for bots */
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  /* PGP encryption block */
  .pgp {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 0.85rem 0.95rem;
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 5px;
  }

  .pgp-toggle {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.82rem;
    color: var(--text);
    cursor: pointer;
  }

  .pgp-toggle input { accent-color: var(--accent); width: 15px; height: 15px; }

  .pgp-key summary {
    cursor: pointer;
    font-size: 0.74rem;
    color: var(--text-dim);
    width: fit-content;
  }

  .pgp-key summary:hover { color: var(--accent); }

  .pgp-key pre {
    margin-top: 0.5rem;
    padding: 0.6rem 0.7rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: 0.62rem;
    line-height: 1.35;
    color: var(--text-faint);
    overflow-x: auto;
    white-space: pre;
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 0.25rem;
  }

  .submit {
    font-size: 0.85rem;
    color: var(--bg);
    background: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 5px;
    padding: 0.55rem 1.1rem;
    cursor: pointer;
    transition: filter 0.15s ease, opacity 0.15s ease;
  }

  .submit .dollar { opacity: 0.7; }
  .submit:hover { filter: brightness(1.08); }
  .submit:disabled { opacity: 0.6; cursor: default; }

  .status { font-size: 0.82rem; color: var(--text-dim); }
  .status.ok { color: var(--accent); }
  .status.err { color: var(--lang-cpp); }

  .alt {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-dim);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .alt .discord strong,
  .alt .irc strong { color: var(--accent); font-weight: 500; }

  .alt-hint {
    margin-top: 0.55rem;
    font-size: 0.76rem;
    line-height: 1.65;
    color: var(--text-faint);
    max-width: 62ch;
  }

  .alt-hint code {
    color: var(--accent);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.05em 0.35em;
  }
</style>
