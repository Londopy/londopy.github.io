---
// Site-wide command palette. Press / (or Ctrl/⌘ K, or the nav's search
// button) to jump to any page, project, domain or blog post, or to switch the
// theme. The first open loads the API's search index (/api/v1/search.json);
// if that fails it still offers the main pages.
---

<div id="cmdk" class="cmdk" hidden>
  <div class="cmdk-backdrop" data-cmdk-close></div>
  <div class="cmdk-panel mono" role="dialog" aria-modal="true" aria-label="Search the site">
    <div class="cmdk-input-row">
      <span class="cmdk-prompt" aria-hidden="true">&gt;</span>
      <input
        id="cmdk-input"
        class="cmdk-input"
        type="text"
        placeholder="jump to a project, page or post…"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="true"
        aria-controls="cmdk-list"
        aria-autocomplete="list"
      />
      <button class="cmdk-esc" type="button" data-cmdk-close aria-label="Close">esc</button>
    </div>
    <ul id="cmdk-list" class="cmdk-list" role="listbox" aria-label="Results"></ul>
    <div class="cmdk-foot" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> move</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>ctrl</kbd><kbd>↵</kbd> new tab</span>
      <span class="cmdk-count"></span>
    </div>
  </div>
</div>

<style>
  .cmdk {
    position: fixed;
    inset: 0;
    z-index: 200;
  }

  .cmdk-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(4, 7, 11, 0.62);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  .cmdk-panel {
    position: relative;
    width: min(640px, calc(100vw - 1.5rem));
    margin: 12vh auto 0;
    background: var(--bg-card);
    border: 1px solid var(--border-bright);
    border-radius: 10px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(var(--accent-rgb), 0.08);
    overflow: hidden;
    animation: cmdk-in 0.14s ease-out;
  }

  @keyframes cmdk-in {
    from { opacity: 0; transform: translateY(-6px) scale(0.99); }
    to { opacity: 1; transform: none; }
  }

  .cmdk-input-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid var(--border);
  }

  .cmdk-prompt { color: var(--accent); font-weight: 600; }

  .cmdk-input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    background: none;
    border: none;
    outline: none;
    caret-color: var(--accent);
  }

  .cmdk-input::placeholder { color: var(--text-faint); }

  .cmdk-esc {
    font: inherit;
    font-size: 0.68rem;
    color: var(--text-faint);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
    cursor: pointer;
  }

  .cmdk-esc:hover { color: var(--accent); border-color: var(--accent); }

  .cmdk-list {
    list-style: none;
    max-height: min(56vh, 460px);
    overflow-y: auto;
    padding: 0.35rem;
    scrollbar-width: thin;
    scrollbar-color: var(--border-bright) transparent;
  }

  .cmdk-list :global(.cmdk-item) {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, auto) minmax(0, 1fr);
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.5rem 0.6rem;
    border-radius: 6px;
    border-left: 2px solid transparent;
    cursor: pointer;
    font-size: 0.84rem;
  }

  .cmdk-list :global(.cmdk-item.active) {
    background: var(--accent-dim);
    border-left-color: var(--accent);
  }

  .cmdk-list :global(.cmdk-kind) {
    font-size: 0.66rem;
    color: var(--text-faint);
    text-align: right;
  }

  .cmdk-list :global(.cmdk-kind[data-kind="project"]) { color: var(--accent); }

  .cmdk-list :global(.cmdk-title) {
    color: var(--text);
    white-space: nowrap;
  }

  .cmdk-list :global(.cmdk-title mark) {
    background: none;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .cmdk-list :global(.cmdk-sub) {
    color: var(--text-faint);
    font-family: var(--sans);
    font-size: 0.78rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .cmdk-list :global(.cmdk-empty) {
    color: var(--text-faint);
    font-size: 0.84rem;
    padding: 0.9rem 0.7rem;
  }

  .cmdk-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    padding: 0.5rem 0.9rem;
    border-top: 1px solid var(--border);
    font-size: 0.68rem;
    color: var(--text-faint);
  }

  .cmdk-foot kbd {
    font: inherit;
    border: 1px solid var(--border-bright);
    border-radius: 3px;
    padding: 0 0.3rem;
    margin-right: 0.2rem;
    color: var(--text-dim);
  }

  .cmdk-count { margin-left: auto; }

  :global(html.cmdk-open) { overflow: hidden; }

  @media (max-width: 560px) {
    .cmdk-panel { margin-top: 5vh; }
    .cmdk-list :global(.cmdk-item) { grid-template-columns: 3.6rem minmax(0, 1fr); }
    .cmdk-list :global(.cmdk-sub) { grid-column: 2; margin-top: -0.35rem; }
    .cmdk-foot { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cmdk-panel { animation: none; }
  }
</style>

<script>
  import { escapeHtml } from "../lib/ansi.js";

  type Item = { kind: string; title: string; subtitle: string; path: string; keywords: string[] };
  type Result = { item: Item; score: number; hits: number[] };

  const root = document.getElementById("cmdk")!;
  const input = document.getElementById("cmdk-input") as HTMLInputElement;
  const list = document.getElementById("cmdk-list")!;
  const count = root.querySelector(".cmdk-count")!;

  const THEMES = ["amber", "slate", "terracotta"];
  const ACTIONS: Item[] = THEMES.map((t) => ({
    kind: "theme",
    title: `theme: ${t}`,
    subtitle: "Switch the accent colour",
    path: `#theme:${t}`,
    keywords: ["theme", "colour", "color", t],
  }));

  // if the index can't be fetched, the main pages still work
  const FALLBACK: Item[] = [
    ["Projects", "/"], ["About", "/about/"], ["Now", "/now/"], ["Contact", "/contact/"],
    ["Blog", "/blog/"], ["API", "/api/"],
  ].map(([title, path]) => ({ kind: "page", title, subtitle: "", path, keywords: [] }));

  const ORDER: Record<string, number> = { page: 0, project: 1, domain: 2, post: 3, theme: 4 };
  const BOOST: Record<string, number> = { page: 0.6, project: 0.5, domain: 0.2, post: 0.1, theme: 0 };

  let items: Item[] = [];
  let loading: Promise<void> | null = null;
  let results: Result[] = [];
  let active = 0;
  let returnFocus: HTMLElement | null = null;

  function load() {
    loading ??= fetch("/api/v1/search.json")
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((j) => { items = [...j.data, ...ACTIONS]; })
      .catch(() => { items = [...FALLBACK, ...ACTIONS]; });
    return loading;
  }

  // one character per code point, accents dropped: "Résumé" → "resume"
  const fold = (s: string) => [...s].map((c) => c.normalize("NFD")[0].toLowerCase());

  // subsequence match on the title: consecutive and word-start hits score higher
  function fuzzy(q: string[], text: string) {
    const t = fold(text);
    const hits: number[] = [];
    let score = 0;
    let from = 0;
    for (const ch of q) {
      const i = t.indexOf(ch, from);
      if (i < 0) return null;
      score += i === hits[hits.length - 1] + 1 ? 3 : 1;
      if (i === 0 || " -_./:".includes(t[i - 1])) score += 2;
      hits.push(i);
      from = i + 1;
    }
    // letters strewn across a long title ("rope" in "Pre-hospital … medicine")
    // aren't a match anyone meant
    if (hits[hits.length - 1] - hits[0] > q.length * 3 + 2) return null;
    const joined = t.join("");
    const qs = q.join("");
    if (joined.startsWith(qs)) score += 6;
    else if (joined.includes(qs)) score += 3;
    return { score: score - hits[0] * 0.05 - (t.length - q.length) * 0.01, hits };
  }

  function rank(query: string): Result[] {
    const q = fold(query.trim());
    if (!q.length) {
      return [...items]
        .sort((a, b) => ORDER[a.kind] - ORDER[b.kind])
        .map((item) => ({ item, score: 0, hits: [] }));
    }
    const qs = q.join("");
    const out: Result[] = [];
    for (const item of items) {
      const t = fuzzy(q, item.title);
      let score = t ? t.score * 2 : -Infinity;
      for (const k of item.keywords) {
        const kf = fold(k).join("");
        if (kf.startsWith(qs)) score = Math.max(score, 8 + qs.length);
        else if (qs.length > 2 && kf.includes(qs)) score = Math.max(score, 4 + qs.length);
      }
      if (score === -Infinity && qs.length > 2 && fold(item.subtitle).join("").includes(qs)) score = 1 + qs.length * 0.5;
      if (score > -Infinity) out.push({ item, score: score + BOOST[item.kind], hits: t ? t.hits : [] });
    }
    return out.sort((a, b) => b.score - a.score).slice(0, 40);
  }

  function highlight(title: string, hits: number[]) {
    const set = new Set(hits);
    return [...title].map((c, i) => (set.has(i) ? `<mark>${escapeHtml(c)}</mark>` : escapeHtml(c))).join("");
  }

  function render() {
    active = Math.min(active, Math.max(results.length - 1, 0));
    list.innerHTML = results.length
      ? results
          .map(
            (r, i) =>
              `<li id="cmdk-opt-${i}" class="cmdk-item${i === active ? " active" : ""}" role="option" aria-selected="${i === active}" data-i="${i}">` +
              `<span class="cmdk-kind" data-kind="${r.item.kind}">${r.item.kind}</span>` +
              `<span class="cmdk-title">${highlight(r.item.title, r.hits)}</span>` +
              `<span class="cmdk-sub">${escapeHtml(r.item.subtitle)}</span></li>`
          )
          .join("")
      : `<li class="cmdk-empty">nothing matches “${escapeHtml(input.value.trim())}”</li>`;
    if (results.length) input.setAttribute("aria-activedescendant", `cmdk-opt-${active}`);
    else input.removeAttribute("aria-activedescendant");
    count.textContent = `${results.length} result${results.length === 1 ? "" : "s"}`;
  }

  function update() {
    results = rank(input.value);
    active = 0;
    render();
    list.scrollTop = 0;
  }

  function move(delta: number) {
    if (!results.length) return;
    active = (active + delta + results.length) % results.length;
    render();
    document.getElementById(`cmdk-opt-${active}`)?.scrollIntoView({ block: "nearest" });
  }

  function go(item: Item, newTab = false) {
    if (item.kind === "theme") {
      const theme = item.path.split(":")[1];
      document.documentElement.dataset.theme = theme;
      try {
        localStorage.setItem("theme", theme);
      } catch {
        /* private mode */
      }
      document.dispatchEvent(new CustomEvent("theme:change"));
      close();
      return;
    }
    close(false);
    if (newTab) window.open(item.path, "_blank", "noopener");
    else location.href = item.path;
  }

  function open() {
    if (!root.hidden) return;
    returnFocus = document.activeElement as HTMLElement | null;
    root.hidden = false;
    document.documentElement.classList.add("cmdk-open");
    input.value = "";
    input.focus();
    list.innerHTML = `<li class="cmdk-empty">loading the index…</li>`;
    load().then(() => {
      if (!root.hidden) update();
    });
  }

  function close(restoreFocus = true) {
    if (root.hidden) return;
    root.hidden = true;
    document.documentElement.classList.remove("cmdk-open");
    if (restoreFocus) returnFocus?.focus?.();
  }

  input.addEventListener("input", update);

  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") { e.preventDefault(); move(1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); move(-1); }
    else if (e.key === "Enter") {
      e.preventDefault();
      const r = results[active];
      if (r) go(r.item, e.ctrlKey || e.metaKey);
    }
    else if (e.key === "Escape") { e.preventDefault(); close(); }
    else if (e.key === "Tab") e.preventDefault(); // focus stays in the palette
  });

  list.addEventListener("mousemove", (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>(".cmdk-item");
    if (li && Number(li.dataset.i) !== active) {
      active = Number(li.dataset.i);
      render();
    }
  });

  list.addEventListener("click", (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>(".cmdk-item");
    if (li) go(results[Number(li.dataset.i)].item, e.ctrlKey || e.metaKey);
  });

  root.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("[data-cmdk-close]")) close();
  });

  document.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("[data-palette-open]")) {
      e.preventDefault();
      open();
    }
  });

  document.addEventListener("keydown", (e) => {
    const t = e.target as HTMLElement;
    const typing = t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName);
    if ((e.key === "k" || e.key === "K") && (e.ctrlKey || e.metaKey) && !e.altKey) {
      e.preventDefault();
      if (root.hidden) open();
      else close();
    } else if (e.key === "/" && !typing && !e.ctrlKey && !e.metaKey && !e.altKey) {
      e.preventDefault();
      open();
    }
  });
</script>
