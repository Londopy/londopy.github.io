---
interface Props {
  active?: "home" | "about" | "contact" | "api";
}

const { active = "home" } = Astro.props;
---

<nav class="topnav mono">
  <div class="container inner">
    <a href="/" class="brand">
      <span class="glyph" aria-hidden="true">&gt;_</span> londopy
    </a>
    <div class="right">
      <div class="links">
        <a href="/" class:list={["navlink", { active: active === "home" }]}>projects</a>
        <a href="/blog/" class="navlink">blog</a>
        <a href="/api/" class:list={["navlink", "nav-api", { active: active === "api" }]}>api</a>
        <a href="/about/" class:list={["navlink", { active: active === "about" }]}>about</a>
        <a href="/contact/" class:list={["navlink", { active: active === "contact" }]}>contact</a>
        <a href="https://github.com/Londopy" class="navlink">github ↗</a>
      </div>
      <div class="theme-switch" role="group" aria-label="Accent theme">
        <span class="ts-label">theme</span>
        <button class="ts-dot amber" type="button" data-theme-set="amber" title="Amber" aria-label="Amber theme"></button>
        <button class="ts-dot slate" type="button" data-theme-set="slate" title="Slate blue" aria-label="Slate blue theme"></button>
        <button class="ts-dot terracotta" type="button" data-theme-set="terracotta" title="Terracotta" aria-label="Terracotta theme"></button>
      </div>
    </div>
  </div>
</nav>

<style>
  .topnav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background: rgba(10, 14, 19, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
  }

  .brand {
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .brand:hover { text-decoration: none; }

  .glyph { color: var(--accent); }

  .links {
    display: flex;
    gap: 0.35rem;
  }

  .navlink {
    color: var(--text-dim);
    font-size: 0.82rem;
    padding: 0.35rem 0.7rem;
    border-radius: 4px;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .navlink:hover {
    color: var(--accent);
    background: var(--accent-dim);
    text-decoration: none;
  }

  .navlink.active {
    color: var(--accent);
  }

  .right {
    display: flex;
    align-items: center;
    gap: 0.5rem 0.9rem;
  }

  .theme-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-left: 0.6rem;
    border-left: 1px solid var(--border);
  }

  .ts-label {
    color: var(--text-faint);
    font-size: 0.72rem;
  }

  .ts-dot {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    padding: 0;
    cursor: pointer;
    border: 2px solid transparent;
    outline: 1px solid var(--border-bright);
    outline-offset: 1px;
    transition: transform 0.14s ease, outline-color 0.14s ease;
  }

  .ts-dot:hover { transform: scale(1.18); }
  .ts-dot.amber { background: #e9a13a; }
  .ts-dot.slate { background: #5aa9e6; }
  .ts-dot.terracotta { background: #e0714a; }

  .ts-dot.active {
    outline-color: var(--text);
    box-shadow: 0 0 0 2px var(--bg);
  }

  /* small screens: the brand and theme dots share the top row and the links
     get a row of their own, so nothing runs past the edge of a phone */
  @media (max-width: 560px) {
    .inner {
      flex-wrap: wrap;
      height: auto;
      padding-top: 0.55rem;
      padding-bottom: 0.3rem;
      row-gap: 0.15rem;
    }
    .brand { white-space: nowrap; }
    .right { display: contents; }
    .theme-switch { margin-left: auto; padding-left: 0; border-left: 0; gap: 0.35rem; }
    .ts-label { display: none; }
    .links {
      order: 1;
      flex-basis: 100%;
      flex-wrap: wrap;
      gap: 0.1rem;
      margin-left: -0.45rem;
    }
    .navlink { padding: 0.35rem 0.45rem; }
  }

  /* on the narrowest phones six links need a third row; the API is in the
     footer, so it gives way and the nav stays two rows */
  @media (max-width: 440px) {
    .nav-api { display: none; }
  }
</style>

<script>
  (() => {
    const dots = Array.from(document.querySelectorAll(".ts-dot"));
    if (!dots.length) return;
    const current = () => document.documentElement.dataset.theme || "amber";
    const mark = () =>
      dots.forEach((d) =>
        d.classList.toggle("active", (d as HTMLElement).dataset.themeSet === current())
      );
    mark();
    dots.forEach((d) =>
      d.addEventListener("click", () => {
        const name = (d as HTMLElement).dataset.themeSet || "amber";
        document.documentElement.dataset.theme = name;
        try {
          localStorage.setItem("theme", name);
        } catch (e) {
          /* ignore */
        }
        mark();
      })
    );
  })();
</script>
