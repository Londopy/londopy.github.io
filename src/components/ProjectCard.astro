---
interface Props {
  name: string;
  tagline: string;
  language: string;
  tags: string[];
  repo: string;
  demo?: string | null;
  page?: string | null;
  featured?: boolean;
  stars?: number;
  pushed?: string | null;
  docsUrl?: string | null;
  links?: { label: string; url: string }[] | null;
  award?: Award | null;
}

interface Award {
  place: string;
  medal: "gold" | "silver" | "bronze";
  event: string;
  track?: string;
  url?: string;
}

const { name, tagline, language, tags, repo, demo, page, featured, stars, pushed, docsUrl, links, award } = Astro.props;

const MEDALS = { gold: "🥇", silver: "🥈", bronze: "🥉" };
const awardTitle = award
  ? `${award.medal[0].toUpperCase()}${award.medal.slice(1)} — ${award.place}${award.track ? ` in the ${award.track} track` : ""} at ${award.event}`
  : "";

const LANG_COLORS: Record<string, string> = {
  Rust: "var(--lang-rust)",
  Python: "var(--lang-python)",
  TypeScript: "var(--lang-typescript)",
  "C++": "var(--lang-cpp)",
  Bash: "var(--lang-bash)",
  JavaScript: "var(--lang-javascript)",
  "x86 ASM": "var(--lang-asm)",
  Astro: "var(--lang-astro)",
  Zig: "var(--lang-zig)",
  Nexium: "var(--lang-nexium)",
  Svelte: "var(--lang-svelte)",
  Gleam: "var(--lang-gleam)",
  C: "var(--lang-c)",
  "C#": "var(--lang-csharp)",
  Odin: "var(--lang-odin)",
};

// "Rust + Python" → [Rust, Python]; split only on " + " so "C++" stays intact
const langs = language.split(" + ").map((l) => l.trim()).filter(Boolean);

// label the demo button by where it actually goes
const isPypi = !!demo && demo.includes("pypi.org");
const isItch = !!demo && demo.includes("itch.io");
const demoLabel = isPypi ? "pypi →" : isItch ? "play →" : "demo →";

// derive the pip package name from a PyPI demo URL
const pipPkg = isPypi ? demo!.split("/project/")[1]?.replace(/\/+$/, "") : null;
---

<article
  class="card"
  class:list={[{ featured }]}
  data-tags={tags.join("|")}
  data-langs={langs.join("|")}
  data-name={name}
  data-stars={stars ?? 0}
  data-pushed={pushed ?? ""}
>
  <div class="card-head">
    <h3 class="mono"><a href={repo}>{name}</a></h3>
    {stars && stars >= 2 ? <span class="stars mono" title={`${stars} stars on GitHub`}>★ {stars}</span> : null}
  </div>

  {award && (
    <a class="award mono" data-medal={award.medal} href={award.url ?? repo} title={awardTitle}>
      <span aria-hidden="true">{MEDALS[award.medal]}</span> {award.place} · {award.event}
    </a>
  )}

  <p class="tagline">{tagline}</p>

  <div class="meta mono">
    {langs.map((lang) => (
      <button class="lang" type="button" data-filter-lang={lang} title={`Filter by ${lang}`}>
        <span class="dot" style={`background:${LANG_COLORS[lang] ?? "var(--text-faint)"}`}></span>
        {lang}
      </button>
    ))}
    {tags.map((t) => (
      <button class="tag" type="button" data-filter-tag={t} title={`Filter by #${t}`}>#{t}</button>
    ))}
  </div>

  {pipPkg && (
    <button class="install mono" type="button" data-copy={`pip install ${pipPkg}`} title="Copy to clipboard">
      <span class="dollar" aria-hidden="true">$</span>
      <span class="cmd">pip install {pipPkg}</span>
      <span class="copyicon" aria-hidden="true"></span>
    </button>
  )}

  <div class="actions mono">
    <a class="btn" href={repo}>repo →</a>
    {demo && <a class="btn btn-accent" href={demo}>{demoLabel}</a>}
    {docsUrl
      ? <a class="btn" href={docsUrl}>docs ↗</a>
      : <a class="btn" href={`/projects/${name}/`}>docs →</a>}
    {links?.map((l) => <a class="btn" href={l.url}>{l.label} ↗</a>)}
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.15rem 1.25rem 1.1rem;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--border-bright);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  .card.featured {
    border-color: rgba(var(--accent-rgb), 0.35);
    background:
      linear-gradient(160deg, rgba(var(--accent-rgb), 0.05), transparent 40%),
      var(--bg-card);
  }

  .card.featured:hover {
    border-color: var(--accent);
  }

  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  h3 a {
    color: var(--text);
  }

  .card:hover h3 a {
    color: var(--accent);
  }

  .stars {
    color: var(--amber);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .tagline {
    color: var(--text-dim);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  /* hackathon placing: a medal-coloured pill under the name */
  .award {
    --medal: var(--bronze);
    align-self: flex-start;
    max-width: 100%;
    font-size: 0.72rem;
    color: var(--medal);
    border: 1px solid color-mix(in srgb, var(--medal) 45%, transparent);
    background: color-mix(in srgb, var(--medal) 9%, transparent);
    border-radius: 999px;
    padding: 0.14rem 0.6rem;
    margin-top: -0.2rem;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .award[data-medal="gold"] { --medal: var(--gold); }
  .award[data-medal="silver"] { --medal: var(--silver); }

  .award:hover {
    border-color: var(--medal);
    background: color-mix(in srgb, var(--medal) 16%, transparent);
    text-decoration: none;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    font-size: 0.72rem;
  }

  /* clickable language + tag filters (reset button chrome) */
  .lang,
  .tag {
    font: inherit;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    border-radius: 3px;
    transition: color 0.12s ease;
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--text);
  }

  .tag {
    color: var(--text-faint);
  }

  .lang:hover,
  .tag:hover {
    color: var(--accent);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  /* copyable pip install line */
  .install {
    display: flex;
    align-items: center;
    gap: 0.5em;
    width: 100%;
    text-align: left;
    font-size: 0.76rem;
    color: var(--text-dim);
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.4rem 0.6rem;
    cursor: pointer;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .install:hover {
    border-color: var(--border-bright);
    color: var(--text);
  }

  .install .dollar {
    color: var(--accent);
  }

  .install .cmd {
    flex: 1;
    overflow-wrap: anywhere;
  }

  .install .copyicon::before {
    content: "⧉";
    color: var(--text-faint);
  }

  .install.copied {
    border-color: var(--accent);
    color: var(--accent);
  }

  .install.copied .copyicon::before {
    content: "✓";
    color: var(--accent);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .btn {
    font-size: 0.75rem;
    color: var(--text-dim);
    border: 1px solid var(--border-bright);
    border-radius: 4px;
    padding: 0.28rem 0.65rem;
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-dim);
    text-decoration: none;
  }

  .btn-accent {
    color: var(--accent);
    border-color: rgba(var(--accent-rgb), 0.4);
  }
</style>
