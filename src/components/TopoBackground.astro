---
// Animated topographic-contour background. The contour lines are generated at
// BUILD time from a seeded value-noise field via marching squares, so the page
// ships as static SVG with zero runtime JS. The lines are stroked with the
// active theme's accent (via CSS vars), and the whole field drifts slowly.
// Motion is disabled under prefers-reduced-motion.

const W = 1440;
const H = 960;
const COLS = 48;
const ROWS = 32;
const LEVELS = 13;

// --- seeded RNG so the map is identical on every build ---
function mulberry32(a) {
  return function () {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rng = mulberry32(20260919);

function makeLattice(gw, gh) {
  const g = [];
  for (let j = 0; j <= gh; j++) {
    const row = [];
    for (let i = 0; i <= gw; i++) row.push(rng());
    g.push(row);
  }
  return g;
}
const smooth = (t) => t * t * (3 - 2 * t);
function sample(lat, gw, gh, u, v) {
  const x = u * gw;
  const y = v * gh;
  const x0 = Math.floor(x);
  const y0 = Math.floor(y);
  const x1 = Math.min(x0 + 1, gw);
  const y1 = Math.min(y0 + 1, gh);
  const tx = smooth(x - x0);
  const ty = smooth(y - y0);
  const a = lat[y0][x0];
  const b = lat[y0][x1];
  const c = lat[y1][x0];
  const d = lat[y1][x1];
  const top = a + (b - a) * tx;
  const bot = c + (d - c) * tx;
  return top + (bot - top) * ty;
}

// three octaves of value noise → soft, flowing terrain
const l1 = makeLattice(7, 5);
const l2 = makeLattice(15, 10);
const l3 = makeLattice(30, 20);
const field = (u, v) =>
  0.55 * sample(l1, 7, 5, u, v) +
  0.3 * sample(l2, 15, 10, u, v) +
  0.15 * sample(l3, 30, 20, u, v);

// sample the field on the grid, then normalise to 0..1
const gx = COLS + 1;
const gy = ROWS + 1;
const cw = W / COLS;
const ch = H / ROWS;
const vals = [];
let lo = Infinity;
let hi = -Infinity;
for (let j = 0; j < gy; j++) {
  const row = [];
  for (let i = 0; i < gx; i++) {
    const val = field(i / COLS, j / ROWS);
    row.push(val);
    if (val < lo) lo = val;
    if (val > hi) hi = val;
  }
  vals.push(row);
}
for (let j = 0; j < gy; j++)
  for (let i = 0; i < gx; i++) vals[j][i] = (vals[j][i] - lo) / (hi - lo);

// --- marching squares: return line segments for one iso level ---
function interp(ax, ay, av, bx, by, bv, level) {
  const t = (level - av) / (bv - av || 1e-6);
  return [ax + (bx - ax) * t, ay + (by - ay) * t];
}
function segmentsForLevel(level) {
  const segs = [];
  for (let j = 0; j < ROWS; j++) {
    for (let i = 0; i < COLS; i++) {
      const x = i * cw;
      const y = j * ch;
      const tl = vals[j][i];
      const tr = vals[j][i + 1];
      const br = vals[j + 1][i + 1];
      const bl = vals[j + 1][i];
      let idx = 0;
      if (tl > level) idx |= 8;
      if (tr > level) idx |= 4;
      if (br > level) idx |= 2;
      if (bl > level) idx |= 1;
      if (idx === 0 || idx === 15) continue;

      const top = () => interp(x, y, tl, x + cw, y, tr, level);
      const right = () => interp(x + cw, y, tr, x + cw, y + ch, br, level);
      const bottom = () => interp(x + cw, y + ch, br, x, y + ch, bl, level);
      const left = () => interp(x, y, tl, x, y + ch, bl, level);

      const push = (p, q) => segs.push([p[0], p[1], q[0], q[1]]);
      switch (idx) {
        case 1: case 14: push(left(), bottom()); break;
        case 2: case 13: push(bottom(), right()); break;
        case 3: case 12: push(left(), right()); break;
        case 4: case 11: push(top(), right()); break;
        case 6: case 9: push(top(), bottom()); break;
        case 7: case 8: push(top(), left()); break;
        case 5: push(top(), left()); push(bottom(), right()); break;
        case 10: push(top(), right()); push(bottom(), left()); break;
      }
    }
  }
  return segs;
}

// --- chain segments sharing endpoints into longer polylines (smaller SVG) ---
const key = (x, y) => `${x.toFixed(1)},${y.toFixed(1)}`;
function chain(segs) {
  const used = new Array(segs.length).fill(false);
  const map = new Map();
  segs.forEach((s, i) => {
    for (const k of [key(s[0], s[1]), key(s[2], s[3])]) {
      if (!map.has(k)) map.set(k, []);
      map.get(k).push(i);
    }
  });
  const nextFrom = (k) => (map.get(k) || []).find((j) => !used[j]);
  const lines = [];
  for (let i = 0; i < segs.length; i++) {
    if (used[i]) continue;
    used[i] = true;
    const pts = [[segs[i][0], segs[i][1]], [segs[i][2], segs[i][3]]];
    for (const dir of ["fwd", "bwd"]) {
      let grow = true;
      while (grow) {
        grow = false;
        const end = dir === "fwd" ? pts[pts.length - 1] : pts[0];
        const j = nextFrom(key(end[0], end[1]));
        if (j == null) break;
        used[j] = true;
        const s = segs[j];
        const a = [s[0], s[1]];
        const b = [s[2], s[3]];
        const add = key(a[0], a[1]) === key(end[0], end[1]) ? b : a;
        if (dir === "fwd") pts.push(add);
        else pts.unshift(add);
        grow = true;
      }
    }
    lines.push(pts);
  }
  return lines;
}
const toPath = (pts) =>
  "M" + pts.map((p) => `${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join("L");

// build the two visual tiers: soft base lines + brighter "index" contours
const soft = [];
const index = [];
for (let n = 1; n <= LEVELS; n++) {
  const level = n / (LEVELS + 1);
  const d = chain(segmentsForLevel(level)).map(toPath).join("");
  if (n % 3 === 0) index.push(d);
  else soft.push(d);
}
---

<div class="topo" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" role="presentation">
    <g class="topo-drift">
      <g class="topo-soft">
        {soft.map((d) => <path d={d} />)}
      </g>
      <g class="topo-index">
        {index.map((d) => <path d={d} />)}
      </g>
    </g>
  </svg>
</div>

<style>
  .topo {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    /* faint accent-tinted wash near the top, plus the base color */
    background:
      radial-gradient(ellipse 90% 55% at 50% -12%, rgba(var(--accent-rgb), 0.06), transparent 70%),
      var(--bg);
  }

  .topo svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .topo-soft path {
    stroke: var(--topo-line-soft);
    stroke-width: 1;
  }

  .topo-index path {
    stroke: var(--topo-line);
    stroke-width: 1.4;
  }

  /* slow "breathing" terrain drift — symmetric keyframes loop seamlessly */
  .topo-drift {
    transform-box: fill-box;
    transform-origin: center;
    animation: topo-drift 48s ease-in-out infinite;
    will-change: transform;
  }

  @keyframes topo-drift {
    0%   { transform: translate(0, 0) scale(1.06); }
    50%  { transform: translate(-2.4%, -1.8%) scale(1.13); }
    100% { transform: translate(0, 0) scale(1.06); }
  }

  @media (prefers-reduced-motion: reduce) {
    .topo-drift {
      animation: none;
      transform: scale(1.04);
    }
  }
</style>
